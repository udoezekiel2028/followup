# Application Settings
APP_ENV=development
DEBUG=True
PORT=8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars

# Supabase (PostgreSQL) Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-secret-key
# Or direct database connection:
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI Providers (Anthropic Claude & OpenAI)
# Use either Claude OR OpenAI (or both):
ANTHROPIC_API_KEY=sk-ant-api03-your-claude-api-key
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-20241022

# Or OpenAI:
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Google OAuth 2.0 Credentials (Gmail API)
# Found in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Automation Safety Defaults
DEFAULT_FOLLOW_UP_DELAY_HOURS=72
DEFAULT_TEST_MODE=True
DEFAULT_AUTO_SEND=False
